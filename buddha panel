local function getClosestPlayerSA(myHRP)
    local closest, closestDist = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and isEnemy(pl) and pl.Character then
            if SilentAimSkipSafeZone and isInSafeZone(pl) then continue end
            if SilentAimSkipPvpOff and isPvPDisabled(pl) then continue end
            local hum = pl.Character:FindFirstChildOfClass("Humanoid")
            local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d <= SilentAimMaxRange and d < closestDist then closestDist = d; closest = pl end
            end
        end
    end
    return closest
end

local function getClosestNPCSA(myHRP)
    local closest, closestDist = nil, math.huge
    for _, npc in ipairs(getAllNPCs()) do
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - myHRP.Position).Magnitude
            if d <= SilentAimMaxRange and d < closestDist then closestDist = d; closest = npc end
        end
    end
    return closest
end

