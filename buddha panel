-- ⚔️ FAST ATTACK
-- ═══════════════════════════════════════════════════════════
local function fireFastAttack(targets)
    if not targets or #targets == 0 then return end
    local hitList = {}
    for _, char in ipairs(targets) do
        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if head then table.insert(hitList, {char, head}) end
    end
    if #hitList == 0 then return end
    local myHRP = getMyHRP()
    if myHRP then
        table.sort(hitList, function(a, b)
            return (a[2].Position - myHRP.Position).Magnitude < (b[2].Position - myHRP.Position).Magnitude
        end)
    end
    pcall(function()
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(hitList[1][2], hitList)
    end)
end

local function StartFastAttack()
    if FastAttackConnection then FastAttackConnection:Disconnect() end
