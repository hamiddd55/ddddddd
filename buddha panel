local function getMyHRP()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function isAllyWithMe(targetPlayer)
    local myGui = lp:FindFirstChild("PlayerGui")
    if not myGui then return false end
    local scrolling = myGui:FindFirstChild("Main")
        and myGui.Main:FindFirstChild("Allies")
        and myGui.Main.Allies:FindFirstChild("Container")
        and myGui.Main.Allies.Container:FindFirstChild("Allies")
        and myGui.Main.Allies.Container.Allies:FindFirstChild("ScrollingFrame")
    if scrolling then
        for _, frame in pairs(scrolling:GetDescendants()) do
            if frame:IsA("ImageButton") and frame.Name == targetPlayer.Name then
                return true
            end
        end
    end
    return false
end

local function isEnemy(targetPlayer)
    if not targetPlayer or targetPlayer == lp then return false end
    local myTeam = lp.Team
    local targetTeam = targetPlayer.Team
    if myTeam and targetTeam then
        if myTeam.Name == "Pirates" and targetTeam.Name == "Marines" then return true end
        if myTeam.Name == "Marines" and targetTeam.Name == "Pirates" then return true end
        if myTeam.Name == "Pirates" and targetTeam.Name == "Pirates" then
            if isAllyWithMe(targetPlayer) then return false end
            return true
        end
        if myTeam.Name == "Marines" and targetTeam.Name == "Marines" then return false end
    end
    return true
end

local function isInSafeZone(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local char = targetPlayer.Character
    if char:FindFirstChildOfClass("ForceField") then return true end
    for _, attr in ipairs({"SafeZone", "InSafeZone", "SafeZoneShield"}) do
        if char:GetAttribute(attr) == true then return true end
        if targetPlayer:GetAttribute(attr) == true then return true end
    end
    return false
end

local function isPvPDisabled(targetPlayer)
    if not targetPlayer then return false end
    if targetPlayer:GetAttribute("PvpDisabled") == true then return true end
    if targetPlayer.Character and targetPlayer.Character:GetAttribute("PvpDisabled") == true then return true end
    return false
end

local function getAllNPCs()
    local npcs = {}
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, obj in ipairs(enemies:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                local hum = obj:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    table.insert(npcs, obj)
                end
            end
        end
    end
    return npcs
end

local function getPredictedPosition(hrp)
    if not hrp then return nil end
    local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
    if not hum then return hrp.Position end
    if not SilentAimPrediction or hum.WalkSpeed < 5 then
        return hrp.Position
    end
    return hrp.Position + (hrp.Velocity * SilentAimPredictionAmount)
end

local function getAllHitParts(character)
    local parts = {}
    if not character then return parts end
    local priorityNames = {
        "Head", "UpperTorso", "LowerTorso", "Torso",
        "HumanoidRootPart", "LeftUpperArm", "RightUpperArm",
        "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand",
        "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
        "LeftFoot", "RightFoot"
    }
    for _, name in ipairs(priorityNames) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then table.insert(parts, part) end
    end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") then
            local alreadyIn = false
            for _, p in ipairs(parts) do
                if p == child then alreadyIn = true; break end
            end
            if not alreadyIn then table.insert(parts, child) end
        end
    end
    return parts
end

local function buildHitList(character, includeAllParts)
    local hitList = {}
    if not character then return hitList end
    if includeAllParts then
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then table.insert(hitList, {character, part}) end
        end
    else
        local parts = getAllHitParts(character)
        for _, part in ipairs(parts) do table.insert(hitList, {character, part}) end
    end
    return hitList
end

-- ═══════════════════════════════════════════════════════════
-- ⚡ BYPASS TP
-- ═══════════════════════════════════════════════════════════
local function bypassInstantTP(targetCFrame)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local originalPlatform = hum and hum.PlatformStand
    if hum then hum.PlatformStand = true end
    local anchoredParts = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(anchoredParts, part)
            part.Anchored = true
        end
    end
    char:PivotTo(targetCFrame)
    hrp.CFrame = targetCFrame
    task.wait(0.03)
    for _, part in pairs(anchoredParts) do part.Anchored = false end
    if hum then hum.PlatformStand = originalPlatform end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

local ActiveTween = nil
local function tweenTPTo(targetPos, speed)
    local hrp = getMyHRP()
    if not hrp then return end
    speed = speed or 200
    local dist = (targetPos - hrp.Position).Magnitude
    if dist < 3 then return end
    if ActiveTween then ActiveTween:Cancel() end
    ActiveTween = TweenService:Create(hrp, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    ActiveTween:Play()
end

-- ═══════════════════════════════════════════════════════════
-- 🌀 M1 TP
-- ═══════════════════════════════════════════════════════════
local function findM1TPTarget()
    local myHRP = getMyHRP()
    if not myHRP then return nil, nil, nil end
    local myPos = myHRP.Position
    local closest, closestDist, closestType = nil, math.huge, nil

    if M1TP_TargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Character and isEnemy(p) then
                if M1TP_SkipSafeZone and isInSafeZone(p) then continue end
                if M1TP_SkipPvPOff and isPvPDisabled(p) then continue end
                local hum = p.Character:FindFirstChild("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local d = (hrp.Position - myPos).Magnitude
                    if d <= M1TP_MaxDist and d < closestDist then
                        closest, closestDist, closestType = p.Character, d, "player"
                    end
                end
            end
        end
    end

    if M1TP_TargetNPCs then
        for _, npc in ipairs(getAllNPCs()) do
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myPos).Magnitude
                if d <= M1TP_MaxDist and d < closestDist then
                    closest, closestDist, closestType = npc, d, "npc"
                end
            end
        end
    end
    return closest, closestDist, closestType
end

local function doM1TP()
    if not M1TP_Enabled then return end
    if tick() - M1TP_LastTrigger < M1TP_Cooldown then return end
    M1TP_LastTrigger = tick()
    local target = findM1TPTarget()
    if not target then return end
    local myHRP = getMyHRP()
    if not myHRP then return end
    local originalPos = myHRP.CFrame.Position
    local tHRP = target:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    bypassInstantTP(tHRP.CFrame * CFrame.new(0, 0, -3))
    task.wait(0.05)
    local hitList = buildHitList(target, true)
    if #hitList > 0 then
        pcall(function()
            RegisterAttack:FireServer(0)
            RegisterHit:FireServer(hitList[1][2], hitList)
        end)
        M1TP_HitCount = M1TP_HitCount + 1
    end
    task.wait(M1TP_ReturnDelay)
    bypassInstantTP(CFrame.new(originalPos))
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if M1TP_Enabled and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        task.spawn(doM1TP)
    end
end)

