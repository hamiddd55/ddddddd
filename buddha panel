local function registerNPCSpawn(npc)
    if not BringMobsNPCSpawns[npc] then
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        if hrp then BringMobsNPCSpawns[npc] = {position = hrp.Position, saved = true} end
    end
end

local function returnNPCToSpawn(npc)
    local spawnData = BringMobsNPCSpawns[npc]
    if not spawnData or not spawnData.saved then return end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function() hrp:SetNetworkOwner(lp) end)
    pcall(function()
        npc:PivotTo(CFrame.new(spawnData.position))
        hrp.CFrame = CFrame.new(spawnData.position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function StartBringMobs()
    if BringMobsConn then BringMobsConn:Disconnect() end
    BringMobsConn = RunService.Heartbeat:Connect(function()
        if not BringMobsEnabled then return end
        pcall(function()
            local myHRP = getMyHRP()
            if not myHRP then return end
            local myPos = myHRP.Position
            for _, npc in ipairs(getAllNPCs()) do
                local hum = npc:FindFirstChild("Humanoid")
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    registerNPCSpawn(npc)
                    local distToMe = (hrp.Position - myPos).Magnitude
                    local spawnPos = BringMobsNPCSpawns[npc].position
                    local distToSpawn = (hrp.Position - spawnPos).Magnitude
                    if distToSpawn > BringMobsMaxDistance then returnNPCToSpawn(npc); continue end
                    if distToMe <= BringMobsRange and distToMe > 5 then
                        local direction = (hrp.Position - myPos).Unit
                        local newPos = myPos + direction * 5
                        local newDistToSpawn = (newPos - spawnPos).Magnitude
                        if newDistToSpawn <= BringMobsMaxDistance then
                            pcall(function() hrp:SetNetworkOwner(lp) end)
                            pcall(function()
                                npc:PivotTo(CFrame.new(newPos, myPos))
                                hrp.CFrame = CFrame.new(newPos)
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                    end
                end
            end
        end)
    end)
end

local function StopBringMobs()
    if BringMobsConn then BringMobsConn:Disconnect(); BringMobsConn = nil end
    BringMobsNPCSpawns = {}
end

local function StartNPCSpawnWatcher()
    if BringMobsReturnConn then BringMobsReturnConn:Disconnect() end
