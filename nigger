local function mkToggle(label, y, getter, setter)
    local btn = Instance.new("TextButton", Panel)
    btn.Size = UDim2.new(1, -16, 0, 26)
    btn.Position = UDim2.new(0, 8, 0, y)
    btn.BackgroundColor3 = CARD
    btn.BorderSizePixel = 0
    btn.Text = label .. ": " .. (getter() and "ON" or "OFF")
    btn.TextColor3 = getter() and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(220, 200, 220)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    mkCorner(btn, 6)
    btn.MouseButton1Click:Connect(function()
        setter(not getter())
        btn.Text = label .. ": " .. (getter() and "ON" or "OFF")
        btn.TextColor3 = getter() and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(220, 200, 220)
    end)
    return btn
end

mkToggle("⚔️ Melee", 76,
    function() return CONFIG.MeleeEnabled end,
    function(v) CONFIG.MeleeEnabled = v end)

mkToggle("🍎 Fruit", 106,
    function() return CONFIG.FruitEnabled end,
    function(v) CONFIG.FruitEnabled = v end)

-- Interval
local intLbl = Instance.new("TextLabel", Panel)
intLbl.Size = UDim2.new(0, 140, 0, 26)
intLbl.Position = UDim2.new(0, 8, 0, 138)
