--[[
    SORU FAST ATTACK — Melee + Fruit M1 (Same Time)
    Range: 120 studs (fixed)
--]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- ═══════════════════════════════════════════════════════════
-- REMOTES
-- ═══════════════════════════════════════════════════════════
local Net, RegisterHit, RegisterAttack
do
    local ok, res = pcall(function()
        return ReplicatedStorage:WaitForChild("Modules", 5):WaitForChild("Net", 5)
    end)
    if ok and res then
        Net = res
        RegisterHit    = Net:FindFirstChild("RE/RegisterHit")
        RegisterAttack = Net:FindFirstChild("RE/RegisterAttack")
    end
end

-- ═══════════════════════════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════════════════════════
local CONFIG = {
    Enabled       = false,
    Interval      = 0.05,
    Range         = 120,   -- FIXED
    MeleeEnabled  = true,
    FruitEnabled  = true,
}

local Thread, Sent, Status = nil, 0, "Ready"

-- ═══════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════
local function getFruit()
    local char = LocalPlayer.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then return t end
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then return t end
        end
    end
    return nil
end

local function getAllTargets(myPos)
    local list = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                list[#list+1] = { model = p.Character, hrp = hrp, head = p.Character:FindFirstChild("Head") or hrp }
            end
        end
    end

    local enemies = workspace:FindFirstChild("Enemies")
    local scanned = {}
    if enemies then
        for _, npc in ipairs(enemies:GetDescendants()) do
            if npc:IsA("Humanoid") and npc.Health > 0 then
                local model = npc.Parent
                if model and not scanned[model] and not Players:GetPlayerFromCharacter(model) then
                    scanned[model] = true
                    local hrp = model:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        list[#list+1] = { model = model, hrp = hrp, head = model:FindFirstChild("Head") or hrp }
                    end
                end
            end
        end
    end

    if #list == 0 then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    list[#list+1] = { model = obj, hrp = hrp, head = obj:FindFirstChild("Head") or hrp }
                end
            end
        end
    end

    local filtered = {}
    for _, t in ipairs(list) do
        if (t.hrp.Position - myPos).Magnitude <= CONFIG.Range then
            filtered[#filtered+1] = t
        end
    end
    return filtered
end

local function getNearestTarget(myPos)
    local targets = getAllTargets(myPos)
    local best, bestDist = nil, math.huge
    for _, t in ipairs(targets) do
        local d = (t.hrp.Position - myPos).Magnitude
        if d < bestDist then bestDist, best = d, t end
    end
    return best
end

-- ═══════════════════════════════════════════════════════════
-- ATTACK
-- ═══════════════════════════════════════════════════════════
local function fireMelee(target)
    if not RegisterHit or not RegisterAttack then return false end
    pcall(function()
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(target.head, {{target.model, target.head}})
    end)
    return true
end

local function fireFruit(target, myPos, fruit)
    local remote = fruit:FindFirstChild("LeftClickRemote")
    if not remote then return false end

    local dir = (target.hrp.Position - myPos)
    if dir.Magnitude > 0 then dir = dir.Unit else dir = Vector3.new(0, 0, -1) end

    if fruit.Name:find("Kitsune") then
        pcall(function()
            if fruit:FindFirstChild("M1Active") then fruit.M1Active.Value = true end
            if fruit:FindFirstChild("RemoteEvent") then fruit.RemoteEvent:FireServer("M1", 1, true) end
        end)
    end

    pcall(function() remote:FireServer(dir, 1, true) end)
    return true
end

local function startAttack()
    if Thread then task.cancel(Thread) end
    Thread = task.spawn(function()
        while CONFIG.Enabled do
            task.wait(CONFIG.Interval)

            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHrp then Status = "❌ No character"; continue end

            local target = getNearestTarget(myHrp.Position)
            if not target then Status = "🎯 No targets (120 stud)"; continue end

            local fruit = CONFIG.FruitEnabled and getFruit() or nil
            local hitMelee, hitFruit = false, false

            if CONFIG.MeleeEnabled then
                hitMelee = fireMelee(target)
            end

            if CONFIG.FruitEnabled and fruit then
                hitFruit = fireFruit(target, myHrp.Position, fruit)
            end

            Sent = Sent + 1

            local parts = {}
            if hitMelee then parts[#parts+1] = "⚔️ Melee" end
            if hitFruit then parts[#parts+1] = "🍎 " .. fruit.Name end
            if #parts > 0 then
                Status = "✅ " .. table.concat(parts, " + ")
            else
                Status = "❌ Nothing fired"
            end
        end
    end)
end

local function stopAttack()
    CONFIG.Enabled = false
    if Thread then task.cancel(Thread); Thread = nil end
    Status = "⏹️ Stopped"
end

local function toggle()
    if CONFIG.Enabled then stopAttack() else CONFIG.Enabled = true; startAttack() end
end

