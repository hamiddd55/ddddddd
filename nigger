local function mkIntBtn(text, x, delta)
    local b = Instance.new("TextButton", Panel)
    b.Size = UDim2.new(0, 38, 0, 26)
    b.Position = UDim2.new(0, x, 0, 138)
    b.BackgroundColor3 = CARD
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = ACCENT
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    mkCorner(b, 6)
    b.MouseButton1Click:Connect(function()
        CONFIG.Interval = math.clamp(CONFIG.Interval + delta, 0.01, 1)
        intLbl.Text = string.format("Int: %.2fs", CONFIG.Interval)
    end)
end
mkIntBtn("−", 152, -0.01)
mkIntBtn("+", 194, 0.01)

-- Start
local toggleBtn = Instance.new("TextButton", Panel)
toggleBtn.Size = UDim2.new(1, -16, 0, 36)
toggleBtn.Position = UDim2.new(0, 8, 1, -44)
toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 40)
toggleBtn.BorderSizePixel = 0
toggleBtn.Text = "▶ START"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 13
mkCorner(toggleBtn, 8)

local tbs = Instance.new("UIStroke", toggleBtn)
tbs.Color = Color3.fromRGB(100, 220, 120)
tbs.Thickness = 1.3

toggleBtn.MouseButton1Click:Connect(toggle)

-- Drag
local dragging, dragStart, startPos = false, nil, nil
Panel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Panel.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        Panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

task.spawn(function()
    while gui.Parent do
        task.wait(0.25)
        pcall(function()
            statusLbl.Text = "Status: " .. Status
            sentLbl.Text = "Sent: " .. Sent
            if CONFIG.Enabled then
                statusLbl.TextColor3 = Color3.fromRGB(255, 160, 160)
                toggleBtn.Text = "■ STOP"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(120, 30, 40)
                tbs.Color = Color3.fromRGB(220, 100, 100)
            else
                statusLbl.TextColor3 = Color3.fromRGB(200, 180, 200)
                toggleBtn.Text = "▶ START"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 40)
                tbs.Color = Color3.fromRGB(100, 220, 120)
            end
        end)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.V then toggle() end
end)

print("[SORU] Melee + Fruit (120 stud) loaded — V to toggle")
